   "source": [
    "# difference between *args and **kwargs\n",
    "\n",
    "def demo(*args, **kwargs):\n",
    "    print(args)\n",
    "    print(kwargs)\n",
    "\n",
    "demo(1, 2, name=\"Lakshmi\", age=30)\n",
    "\n",
    "# *args → accepts multiple positional arguments (tuple)\n",
    "# **kwargs → accepts multiple keyword arguments (dictionary)"
   ]
  }
 ],
